# ─── PostgreSQL + PostGIS ──────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=agronexo
POSTGRES_USER=agronexo
POSTGRES_PASSWORD=change_me

# URL completa para SQLAlchemy (se construye automáticamente en config.py)
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# db 0 → broker Celery  |  db 1 → caché de estado de análisis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── MinIO ─────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=agronexo_admin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=agronexo
MINIO_USE_SSL=false
# Expiración de URLs firmadas en segundos (1 hora)
MINIO_PRESIGNED_URL_EXPIRY=3600

# ─── JWT / Auth ────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── FastAPI ───────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
