FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    ca-certificates \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libpangoft2-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libcairo2 \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Certificado raíz de Avast (SSL/TLS scanning) — sin esto, pip no puede
# verificar HTTPS a pypi.org en máquinas con Avast interceptando TLS.
COPY docker/certs/avast-root.crt /usr/local/share/ca-certificates/avast-root.crt
RUN update-ca-certificates

COPY docker/requirements.api.txt .
RUN pip install --no-cache-dir -r requirements.api.txt

COPY app/ ./app/
COPY migrations/ ./migrations/
COPY alembic.ini .

EXPOSE 8000
