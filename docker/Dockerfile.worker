# GDAL requiere imagen con librerías geoespaciales del sistema
FROM ghcr.io/osgeo/gdal:ubuntu-small-3.9.0

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements.worker.txt .
RUN pip3 install --no-cache-dir --break-system-packages --ignore-installed -r requirements.worker.txt

COPY workers/ ./workers/
COPY app/ ./app/
