# GDAL requiere imagen con librerías geoespaciales del sistema
FROM ghcr.io/osgeo/gdal:ubuntu-small-3.13.3

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    libpq-dev \
    gcc \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Certificado raíz de Avast (SSL/TLS scanning) — sin esto, pip no puede
# verificar HTTPS a pypi.org en máquinas con Avast interceptando TLS.
COPY docker/certs/avast-root.crt /usr/local/share/ca-certificates/avast-root.crt
RUN update-ca-certificates

COPY docker/requirements.worker.txt .
RUN pip3 install --no-cache-dir --break-system-packages --ignore-installed -r requirements.worker.txt

COPY workers/ ./workers/
COPY app/ ./app/
