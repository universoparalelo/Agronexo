# Imagen de producción: build estático del frontend + Nginx como reverse proxy.
# Sustituye al Dockerfile.frontend de desarrollo (que corre el dev server de Vite,
# pensado para HMR, no para servir tráfico real).

FROM node:25-slim AS build

WORKDIR /app

COPY docker/certs/avast-root.crt /usr/local/share/ca-certificates/avast-root.crt
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/avast-root.crt

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build

FROM nginx:1.31-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 443
