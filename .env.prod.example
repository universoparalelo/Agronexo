# Template de variables de entorno de PRODUCCIÓN. Copiar a `.env.prod` en el
# servidor (nunca versionar ese archivo) y reemplazar TODOS los valores de
# ejemplo — ninguno de estos sirve tal cual en un despliegue real.

# ─── PostgreSQL + PostGIS ──────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=agronexo
POSTGRES_USER=agronexo
# Generar con: openssl rand -hex 24
POSTGRES_PASSWORD=REEMPLAZAR_password_fuerte_unica

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─── MinIO ─────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=REEMPLAZAR_usuario_minio
# Generar con: openssl rand -hex 24
MINIO_ROOT_PASSWORD=REEMPLAZAR_password_fuerte_unica
MINIO_BUCKET=agronexo
MINIO_USE_SSL=false
MINIO_PRESIGNED_URL_EXPIRY=3600
# Dominio público real (no localhost) — las URLs firmadas las consume el
# navegador del usuario final, no otro contenedor de la red interna.
MINIO_PUBLIC_ENDPOINT=REEMPLAZAR_dominio_o_ip_publica:9000

# ─── JWT / Auth ────────────────────────────────────────────────────
# Generar con: openssl rand -hex 32 — NUNCA reutilizar el valor de desarrollo
JWT_SECRET_KEY=REEMPLAZAR_generar_con_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── FastAPI ───────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
# Dominio(s) público(s) real(es) del frontend — nunca localhost en producción
ALLOWED_ORIGINS=https://REEMPLAZAR_dominio_real

# ─── Usuario administrador inicial ─────────────────────────────────
# El seed/migración que crea el usuario admin debe leer estas variables en vez
# de hardcodear el usuario y la contraseña de desarrollo (ver tarea pendiente en
# docs/release-v4.0.0.md — HU-R4-06, criterio "credenciales de desarrollo
# reemplazadas").
ADMIN_EMAIL=REEMPLAZAR_email_real
ADMIN_PASSWORD=REEMPLAZAR_password_fuerte_unica
